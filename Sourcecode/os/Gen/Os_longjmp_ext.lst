                          1 ;
                          2 ; TriCoreTasking longjmp functions
                          3 ;
                          4 ; Copyright ETAS GmbH 2024
                          5 ;
                          6 ; [$TargetTT  155]
                          7 ;
                          8 ; Notes:
                          9 ;    This version checks for lower contexts and hence copes with longjmp over
                         10 ;    frames with ISRs in the way.
                         11 ;
                         12 ;    1) Need to handle trusted/nontrusted longjmps
                         13 ;
                         14 ;    Gets the PCXI value from the buffer and then pops off CSAs of the CSA
                         15 ;    list until we get to the CSA used when calling setjmp.
                         16 ;
                         17 ;    If it finds a lower context in the CSA list then restores this
                         18 ;
                         19 ;    Checks if the the PSW needs to change to USER mode for untrusted code
                         20 ;
                         21 ;    Clears the PSW call depth counter
                         22 ;
                         23   .name  "Os_longjmp_ext.asm"
                         24   .sdecl '.text.Os_longjmp_ext.Os_longjmp_ext',CODE
0000                     25   .sect  '.text.Os_longjmp_ext.Os_longjmp_ext'
                         26   .align 4
                         27 
                         28   .global Os_longjmp_ext
                         29   ; Entered with A4 containing the address of the jump buffer. OS level
0000                     30 Os_longjmp_ext: .type func
0000 09420409  1    1    31   ld.w    d2,[a4]4                       ; Read saved PCXI
0004                     32 Os_longjmp_ext1:
0004 91r0rr5r  1    2    33   movh.a  a5,#@his(Os_longjmp_ext_loop)  ; Get loop address into a5
0008 D955rrrr  1    3    34   lea     a5,[a5]@los(Os_longjmp_ext_loop)
000C                     35 Os_longjmp_ext_loop:
000C 4D00E0FF  1    4    36   mfcr    d15,#0xFE00                    ; Read PCXI
0010 5FF20600  1    5    37   jeq     d2,d15, Os_longjmp_vexit       ; Does it match exit value?
0014 EF4F0700  1    6    38   jz.t    d15: 20, Os_longjmp_lcx        ; Is this a lower context (1.6E/P case) ?
0018 405B      1    7    39   mov.aa  a11,a5                         ; 'ret' back to loop, popping a CSA
001A 0090      2    9    40   ret
                         41 
                         42   .align  4
                         43   .extern Os_longjmp_exit
001C                     44 Os_longjmp_vexit:
001C 0000      1   10    45   nop                                    ; CPU_TC.065
001E 1Drrrrrr  1   11    46   j Os_longjmp_exit
0022                     47 Os_longjmp_lcx:
0022 022F      1   12    48   mov     d15,d2
0024 404C      1   13    49   mov.aa  a12,a4
0026 0D004002  4   17    50   rslcx
002A 0000      1   18    51   nop                                    ; CPU_TC.069
002C 02F2      1   19    52   mov     d2,d15
002E 40C4      1   20    53   mov.aa  a4,a12
