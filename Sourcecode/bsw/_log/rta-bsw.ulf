<LOG-ENTRY TI="oAW Validations" S="1b4019c50c03fdac49c8962b654660c1" T="2024-06-21T10:43:09.815+0800">
<SHORT-NAME>RTA-BSW_299</SHORT-NAME>
<DESC>
<L-2 L="EN">The service Handler function name you have entered is deviating from the below default names...
dcmDspDTCInfoSubFuncLevel        dcmDspDTCSubFuncServHandler
-------------------------               ----------------------------
    0x1                  = Dcm_Dsp_ReportNumberOfDTC
    0x2               = Dcm_Dsp_ReportSupportedDTC
    0x3               = Dcm_Dsp_ReportDTCSnapshotRecordIdentification
    0x4               = Dcm_Dsp_ReportSnapshotRecordByDTCNumber
    0x5                  = Dcm_Dsp_GetFreezeFrameDataByRecord
    0x6               = Dcm_Dsp_ReportExtendedDataRecordByDTCNumber
    0x7                  = Dcm_Dsp_ReportNumberOfDTC
    0x8               = Dcm_Dsp_ReportDTCBySeverityMaskRecord
    0x9                  = Dcm_Dsp_ReportSeverityOfDTC
    0xA               = Dcm_Dsp_ReportSupportedDTC
    0xB                  = Dcm_Dsp_ReportFailedDTC
    0xC                  = Dcm_Dsp_ReportFailedDTC
    0xD               = Dcm_Dsp_ReportFailedDTC
    0xE               = Dcm_Dsp_ReportFailedDTC
    0xF               = Dcm_Dsp_ReportSupportedDTC
    0x10               = Dcm_Dsp_ReportExtendedDataRecordByDTCNumber
    0x11               = Dcm_Dsp_ReportNumberOfDTC
    /* FC_VariationPoint_START */
    0x12               = Dcm_Dsp_ReportNumberOfDTC
    0x13              = Dcm_Dsp_ReportSupportedDTC
           /* FC_VariationPoint_END */
        0x14                      = Dcm_Dsp_ReportFaultDetectionCounter
    0x15              = Dcm_Dsp_ReportSupportedDTC
    0x17             = Dcm_Dsp_ReportSupportedDTC
    0x18             = Dcm_Dsp_ReportSnapshotRecordByDTCNumber
    0x19             = Dcm_Dsp_ReportExtendedDataRecordByDTCNumber
    0x42             = Dcm_Dsp_ReportWWHOBDDTCByMaskRecord
     0x55             = Dcm_Dsp_RdtcReportWWHOBDDTCWithPermanentStatus</L-2>
</DESC>
<CATEGORY>WARN</CATEGORY>
<SDG GID="ULF">
<SD GID="ULF-INCIDENT-URL">manual_config/uds_config/udsOnCan/bsw_config/Services/ECU_EPS_Project_Dcm_EcucValues.arxml</SD>
